{
  "name": "marche-dore-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "seed": "tsx src/seed.ts",
    "dump-catalog": "node scripts/dump-catalog.mjs",
    "catalog:generate": "node scripts/generate-west-africa-catalog.mjs",
    "catalog:validate": "tsx scripts/validate-catalog.mjs",
    "catalog:import": "tsx scripts/import-catalog.mjs",
    "catalog:import:dry-run": "tsx scripts/import-catalog.mjs --dry-run",
    "catalog:media": "node scripts/import-catalog-media.mjs",
    "test:smoke": "node --import tsx --test tests/catalogHelpers.test.ts tests/catalogManifest.test.ts",
    "test:integration": "node --import tsx --test tests/*.integration.test.ts",
    "catalog:qa:api": "node scripts/qa-catalog-api.mjs",
    "typecheck": "tsc --noEmit",
    "schema:export": "node scripts/export-schema.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "dotenv": "^16.6.1",
    "hono": "^4.9.8",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "esbuild": "^0.25.9",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2"
  }
}
