DATABASE_URL=postgres://marche:marche_local@127.0.0.1:5432/marche_dore
PORT=8787
# CORS (navigateurs uniquement ; les apps natives ne sont pas concernées).
# Vide ou * = toutes origines. Liste séparée par des virgules pour restreindre. « off » = aucun en-tête.
# Le panel admin est servi sur la même origine (/panel/) : il n'a pas besoin de CORS.
CORS_ORIGIN=
FEDAPAY_SECRET_KEY=
FEDAPAY_ENV=sandbox
PUBLIC_API_URL=http://172.20.10.2:8787
# Avec ngrok : PUBLIC_API_URL=https://….ngrok-free.app (voir docs/NGROK.md)
DEMO_EMAIL=demo@marchedore.bj
# Mot de passe des comptes démo (dev local uniquement) : fourni en privé.
DEMO_PASSWORD=
# 2e app (ops) — rôles SQL optionnels : marche_ops / marche_ops_local
# Demo picker : picker@marchedore.bj
# Demo courier : courier@marchedore.bj

# Production : NODE_ENV=production désactive le seed des comptes démo (SEED_DEMO=1 pour forcer).
# Le seed ne remplace jamais le mot de passe d'un compte existant.
NODE_ENV=development
SEED_DEMO=
# Secret du webhook FedaPay (Workbench → Webhooks → Click to reveal). Si défini, les webhooks non signés sont rejetés.
FEDAPAY_WEBHOOK_SECRET=
# Sessions staff (CourseGO + panel) : expiration glissante en jours.
STAFF_SESSION_TTL_DAYS=30
# Frais de livraison recalculés côté serveur (doublés pour le créneau urgent).
ORDER_DELIVERY_FEE=1500
# Dossier du build du panel admin servi sur /panel/ (défaut : ../marche-admin/dist).
# PANEL_DIST_DIR=

# Temps réel admin (GET /admin/stream, SSE). Tous optionnels.
# Rétention du journal ops.admin_events (jours, défaut 7).
ADMIN_EVENTS_RETENTION_DAYS=
# Battement SSE en ms (défaut 15000) et fusion des positions GPS coursiers en ms (défaut 1000).
ADMIN_STREAM_HEARTBEAT_MS=
COURIER_POS_FLUSH_MS=
# Nombre maximum de flux SSE simultanés (défaut 200).
ADMIN_STREAM_MAX=
