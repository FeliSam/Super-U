{
  "expo": {
    "name": "CourseGo",
    "slug": "coursego",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "coursego",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.superu.coursego",
      "buildNumber": "7",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIViewControllerBasedStatusBarAppearance": true,
        "NSLocationWhenInUseUsageDescription": "CourseGo utilise votre position pendant les livraisons en route.",
        "NSCameraUsageDescription": "CourseGo scanne les codes-barres et QR des produits en magasin.",
        "NSMicrophoneUsageDescription": "CourseGo utilise le micro pour les appels avec le client.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.superu.coursego",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#058d81",
        "foregroundImage": "./assets/images/icon.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fafaf9",
          "image": "./assets/images/coursego-mark.png",
          "imageWidth": 200
        }
      ],
      "expo-asset",
      "expo-image",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CourseGo utilise votre position pendant les livraisons en route."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "CourseGo scanne les codes-barres et QR des produits en magasin.",
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/coursego-mark.png",
          "color": "#058d81",
          "defaultChannel": "default"
        }
      ],
      "expo-font",
      "react-native-maps",
      "@maplibre/maplibre-react-native"
    ],
    "extra": {
      "privacyPolicyUrl": "https://marchedore.bj/privacy",
      "termsUrl": "https://marchedore.bj/terms",
      "supportEmail": "support@marchedore.bj",
      "router": {},
      "eas": {
        "projectId": "ec3a7b59-415b-46e9-960a-10c49848420a"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "owner": "feliciano6"
  }
}
