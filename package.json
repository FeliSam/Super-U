{
  "name": "super-u",
  "private": true,
  "description": "Monorepo Marché Doré : boutique, CourseGO, Marché Admin et API Postgres",
  "workspaces": [
    "marche-dore",
    "CourseGO",
    "server",
    "marche-admin"
  ],
  "scripts": {
    "dev:api": "npm run dev --prefix server",
    "dev:shop": "npm run web --prefix marche-dore",
    "dev:course": "npm run web --prefix CourseGO",
    "dev:admin": "npm run dev --prefix marche-admin",
    "db:up": "docker compose up -d",
    "catalog:map": "node scripts/gen-catalog-images.mjs"
  }
}
