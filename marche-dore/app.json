{
  "expo": {
    "name": "Marché Doré",
    "slug": "marche-dore",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/brand-mark.png",
    "scheme": "marchedore",
    "userInterfaceStyle": "automatic",
    "androidStatusBar": {
      "hidden": true,
      "translucent": true,
      "backgroundColor": "#00000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.superu.marchedore",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIStatusBarHidden": true,
        "UIViewControllerBasedStatusBarAppearance": false,
        "NSMicrophoneUsageDescription": "Marché Doré utilise le micro pour les appels avec votre coursier.",
        "NSCameraUsageDescription": "Marché Doré utilise la caméra pour vos photos d’avis et de profil.",
        "NSPhotoLibraryUsageDescription": "Marché Doré accède à vos photos pour les ajouter à vos avis.",
        "NSLocationWhenInUseUsageDescription": "Marché Doré utilise votre position pour la livraison et le suivi.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.superu.marchedore",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#e2931d",
        "foregroundImage": "./assets/images/brand-mark.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/brand-mark.png"
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Ionicons.ttf",
            "./assets/fonts/Feather.ttf"
          ]
        }
      ],
      "expo-router",
      [
        "expo-status-bar",
        {
          "hidden": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/brand-mark.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#fdfbf7"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Marché Doré accède à vos photos pour les ajouter à vos avis."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/brand-mark.png",
          "color": "#e2931d",
          "defaultChannel": "default"
        }
      ],
      "expo-asset",
      "expo-image",
      "expo-sqlite",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "privacyPolicyUrl": "https://marchedore.bj/privacy",
      "termsUrl": "https://marchedore.bj/terms",
      "supportEmail": "support@marchedore.bj",
      "router": {},
      "expo-status-bar": {
        "hidden": true
      },
      "eas": {
        "projectId": "20abed55-9ebc-46bc-acd9-14523484f61a"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "owner": "feliciano6"
  }
}
