# Clés API OVHcloud — copie ce fichier en `.env.ovh` à la racine SuperU
# et remplis les vraies valeurs. Ne committe JAMAIS `.env.ovh`.
#
# Création des clés : https://api.ovh.com/createToken/
# Endpoint EU (France) : ovh-eu
# Test : npm run ovh:status

OVH_ENDPOINT=ovh-eu
OVH_APP_KEY=
OVH_APP_SECRET=
OVH_CONSUMER_KEY=

# Après npm run ovh:status — complète selon ce qui s’affiche :
# OVH_DOMAIN=tondomaine.com
# OVH_DNS_SUBDOMAIN=api
# OVH_VPS_SERVICE_NAME=vps-xxxxxx.vps.ovh.net
# Si Public Cloud (pas un VPS classique) :
# OVH_CLOUD_PROJECT_ID=
